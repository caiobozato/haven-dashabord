# Home Assistant base URL, reachable from this server (no trailing slash)
HA_URL=http://192.168.3.2:8123
# Long-lived access token: HA → Profile → Security → Long-lived access tokens
HA_TOKEN=
# Set true for a self-signed HTTPS certificate
HA_ALLOW_SELF_SIGNED=false

# Browser-facing HA URL for deep links (optional)
HA_PUBLIC_URL=http://umbrel.local:8123
